# Production env for compose.prod.yml: copy to .env.prod (git-ignored) and replace every value.
# The values below match the dev infra (compose.infra.yml) so the stack can be smoke-tested locally.

ANNOPHIS_VERSION=latest
# empty = locally built images (annophis-<app>:<version>); default ghcr.io/ghentcdh/
# ANNOPHIS_IMAGE_PREFIX=
ANNOPHIS_PORT=6200

# --- shared by every app ---
SERVICE_AUTH=on
CROUTON_AUTH_SECRET=change-me-long-random
INTERNAL_JWT_SECRET=change-me-long-random
# every key below; services accept calls from these keys
SERVICE_API_KEYS=change-me-gateway,change-me-ms-projects,change-me-ms-corpora,change-me-ms-annotation,change-me-ms-metadata,change-me-text-service-1,change-me-text-service-2,change-me-ml-adapter
KEYCLOAK_URL=http://keycloak.localhost:6480
KEYCLOAK_REALM=annophis
KEYCLOAK_CLIENT_ID=annophis-ui

# --- gateway only: server-side login (confidential client) and its public URL ---
GATEWAY_KEYCLOAK_CLIENT_ID=annophis-gateway
GATEWAY_KEYCLOAK_CLIENT_SECRET=dev-gateway-secret
GATEWAY_PUBLIC_URL=http://localhost:6200
GATEWAY_KEYCLOAK_CALLBACK_URL=http://localhost:6200/api/_app/auth/keycloak/callback

# --- per app: database (user + schema) and API key ---
GATEWAY_DATABASE_URL=postgresql://gateway:dev@postgres:5432/annophis?schema=gateway
GATEWAY_API_KEY=change-me-gateway
MS_PROJECTS_DATABASE_URL=postgresql://ms_projects:dev@postgres:5432/annophis?schema=ms_projects
MS_PROJECTS_API_KEY=change-me-ms-projects
MS_CORPORA_DATABASE_URL=postgresql://ms_corpora:dev@postgres:5432/annophis?schema=ms_corpora
MS_CORPORA_API_KEY=change-me-ms-corpora
MS_ANNOTATION_DATABASE_URL=postgresql://ms_annotation:dev@postgres:5432/annophis?schema=ms_annotation
MS_ANNOTATION_API_KEY=change-me-ms-annotation
MS_METADATA_DATABASE_URL=postgresql://ms_metadata:dev@postgres:5432/annophis?schema=ms_metadata
MS_METADATA_API_KEY=change-me-ms-metadata
TEXT_SERVICE_1_DATABASE_URL=postgresql://text_service_1:dev@postgres:5432/annophis?schema=text_service_1
TEXT_SERVICE_1_API_KEY=change-me-text-service-1
TEXT_SERVICE_2_DATABASE_URL=postgresql://text_service_2:dev@postgres:5432/annophis?schema=text_service_2
TEXT_SERVICE_2_API_KEY=change-me-text-service-2
ML_ADAPTER_DATABASE_URL=postgresql://ml_adapter:dev@postgres:5432/annophis?schema=ml_adapter
ML_ADAPTER_API_KEY=change-me-ml-adapter
