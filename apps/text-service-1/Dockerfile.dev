# syntax=docker/dockerfile:1.7-labs
FROM node:24-alpine
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@12.10.1 --activate
ENV CI=true
# pnpm store on the same volume as node_modules (the compose anonymous volume): hard links work, and a reinstall
# at start (lockfile changed) reuses the store instead of copying every package (GhentCDH/crouton#694)
ENV npm_config_store_dir=/app/node_modules/.pnpm-store

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY --parents apps/text-service-1/*/package.json generated/text-service-1/default/types/package.json ./

RUN --mount=type=secret,id=npmrc,target=/app/.npmrc pnpm install

CMD pnpm exec nx run ${NX_COMMAND}
