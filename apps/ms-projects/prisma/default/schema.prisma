generator client {
  provider = "prisma-client-js"
  output   = "../../../../generated/ms-projects/default/client"
}

generator crouton {
  provider = "crouton-prisma"
  output   = "../../../../generated/ms-projects/default/types/src"
}

datasource db {
  provider = "postgresql"
  // url is provided by prisma/default/prisma.config.ts (Prisma 7 forbids `url` here)
}

/// A research project. Phase 0 demo resource for the admin UI and entity events.
model Project {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("project")
}
