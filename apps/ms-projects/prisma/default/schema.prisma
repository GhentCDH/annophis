generator client {
  provider = "prisma-client-js"
  output   = "../../../../generated/ms-projects/default/client"
}

generator crouton {
  provider = "crouton-prisma"
  output   = "../../../../generated/ms-projects/default/types/src"
}

datasource db {
  provider = "postgresql"
  // url is provided by prisma/default/prisma.config.ts (Prisma 7 forbids `url` here)
}

/// A research project. Phase 0 demo resource for the admin UI and entity events.
model Project {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("project")
}

/// Transactional outbox: written in the same transaction as the entity change (withEntityEvents in
/// @annophis/events), published to NATS by the OutboxRelay. Internal: excluded from crouton (data-source.json).
model Outbox {
  id          String    @id @db.Uuid
  type        String
  subject     String?
  data        Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  @@index([publishedAt, createdAt])
  @@map("outbox")
}
