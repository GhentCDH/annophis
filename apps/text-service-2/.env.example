DATABASE_URL=postgresql://text_service_2:dev@localhost:6432/annophis?schema=text_service_2
BACKEND_PORT=6111
SERVICE_NAME=text-service-2
NATS_URL=nats://localhost:6422
SERVICE_AUTH=on
# key this service sends as X-Api-Key, and the keys it accepts from other services
SERVICE_API_KEY=dev-key-text-service-2
SERVICE_API_KEYS=dev-key-gateway,dev-key-ms-projects,dev-key-ms-corpora,dev-key-ms-annotation,dev-key-ms-metadata,dev-key-text-service-1,dev-key-text-service-2,dev-key-ml-adapter
INTERNAL_JWT_SECRET=dev-only-change-me
# Admin auth: the gateway logs in via Keycloak and sends X-Internal-Token; no Keycloak/auth-provider config here.
