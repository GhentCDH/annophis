generator client {
  provider = "prisma-client-js"
  output   = "../../../../generated/gateway/default/client"
}

generator crouton {
  provider = "crouton-prisma"
  output   = "../../../../generated/gateway/default/types/src"
}

datasource db {
  provider = "postgresql"
  // url is provided by prisma/default/prisma.config.ts (Prisma 7 forbids `url` here)
}
