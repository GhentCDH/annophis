generator client {
  provider = "prisma-client-js"
  output   = "../../../../generated/gateway/default/client"
}

generator crouton {
  provider = "crouton-prisma"
  output   = "../../../../generated/gateway/default/types/src"
}

datasource db {
  provider = "postgresql"
  // url is provided by prisma/default/prisma.config.ts (Prisma 7 forbids `url` here)
}

/// Transactional outbox: written in the same transaction as the entity change (withEntityEvents in
/// @annophis/events), published to NATS by the OutboxRelay. Internal: excluded from crouton (data-source.json).
model Outbox {
  id          String    @id @db.Uuid
  type        String
  subject     String?
  data        Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  @@index([publishedAt, createdAt])
  @@map("outbox")
}

/// Login sessions of the gateway (express-session via connect-pg-simple; only used during the Keycloak redirect).
/// Shape required by connect-pg-simple. Internal: excluded from crouton (data-source.json).
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
