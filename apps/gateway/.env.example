DATABASE_URL=postgresql://gateway:dev@localhost:6432/annophis?schema=gateway
FRONTEND_PORT=6200
BACKEND_PORT=6100
SERVICE_NAME=gateway
NATS_URL=nats://localhost:6422
SERVICE_AUTH=off
SERVICE_API_KEYS=dev-key-gateway
INTERNAL_JWT_SECRET=dev-only-change-me
# Admin auth: one Keycloak login at the gateway, session token shared via CROUTON_AUTH_SECRET
KEYCLOAK_URL=http://keycloak.localhost:6480
KEYCLOAK_REALM=annophis
KEYCLOAK_CLIENT_ID=annophis-gateway
KEYCLOAK_CLIENT_SECRET=dev-gateway-secret
KEYCLOAK_CALLBACK_URL=http://localhost:6200/api/_app/auth/keycloak/callback
CROUTON_FRONTEND_URL=http://localhost:6200
CROUTON_AUTH_SECRET=dev-only-crouton-auth-secret-change-me
