# syntax=docker/dockerfile:1.7-labs
# Build context: workspace root
# ========================================================
# Stage 1: Install dependencies
# ========================================================
FROM --platform=$BUILDPLATFORM node:24-alpine AS deps

RUN corepack enable && corepack prepare pnpm@12.10.1 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml nx.json tsconfig.base.json pnpm-workspace.yaml ./
COPY --parents apps/ml-adapter/*/package.json generated/ml-adapter/default/types/package.json ./

# The generated Prisma client is not a workspace package, so the committed
# lockfile matches as-is.
RUN --mount=type=secret,id=npmrc,target=/app/.npmrc pnpm install --frozen-lockfile

# ========================================================
# Stage 2: Build
# ========================================================
FROM --platform=$BUILDPLATFORM deps AS build

ENV PRISMA_CLI_BINARY_TARGETS="linux-musl,linux-musl-arm64-openssl-3.0.x"

COPY . .
# Only this app's dependencies are installed: drop the other apps so Nx doesn't load their configs
# (e.g. another app's vite.config.ts) while building the project graph.
RUN find apps -mindepth 1 -maxdepth 1 ! -name ml-adapter -exec rm -rf {} +

# Generate Prisma client for Linux
RUN cd apps/ml-adapter && DATABASE_URL=postgresql://dummy:dummy@localhost:5432/dummy npx prisma generate --config prisma/default/prisma.config.ts

# Build applications
RUN npx nx build ml-adapter-backend

# Create flat node_modules for backend (no pnpm symlinks)
RUN pnpm --filter @ml-adapter/backend deploy --legacy --prod /app/deployed-backend

# Transpile resource & data-source .ts → .js for runtime require()
COPY apps/ml-adapter/crouton-backend/src/app/resources /app/dist/apps/ml-adapter/crouton-backend/resources
COPY apps/ml-adapter/crouton-backend/src/app/data-sources /app/dist/apps/ml-adapter/crouton-backend/data-sources
RUN find /app/dist/apps/ml-adapter/crouton-backend/resources -name '*.ts' \
    | while read f; do \
        npx esbuild "$f" --outfile="${f%.ts}.js" --platform=node --format=cjs --target=node22; \
      done \
    && find /app/dist/apps/ml-adapter/crouton-backend/resources -name '*.ts' -delete
# Data sources import @annophis/* libs (tsconfig paths, not packages): bundle those in, keep npm packages and the
# generated client (copied into node_modules below) external.
RUN find apps/ml-adapter/crouton-backend/src/app/data-sources -name 'index.ts' \
    | while read f; do \
        out="/app/dist/apps/ml-adapter/crouton-backend/data-sources/${f#apps/ml-adapter/crouton-backend/src/app/data-sources/}"; \
        npx esbuild "$f" --bundle --packages=external --external:'@ml-adapter/*' \
          --tsconfig=apps/ml-adapter/crouton-backend/tsconfig.json \
          --outfile="${out%.ts}.js" --platform=node --format=cjs --target=node22; \
      done \
    && find /app/dist/apps/ml-adapter/crouton-backend/data-sources -name '*.ts' -delete

# Transpile generated types .ts → .js
RUN mkdir -p /app/generated/ml-adapter/default/types/src && find /app/generated/ml-adapter/default/types/src -name '*.ts' \
    | while read f; do \
        npx esbuild "$f" --outfile="${f%.ts}.js" --platform=node --format=cjs --target=node22; \
      done \
    && find /app/generated/ml-adapter/default/types/src -name '*.ts' -delete \
    && sed -i 's/index\.ts/index.js/g' /app/generated/ml-adapter/default/types/package.json

# ========================================================
# Stage 3: Production
# ========================================================
FROM node:24-alpine

WORKDIR /app

ARG VERSION=unknown
ARG BUILD_SHA=unknown
ENV APP_VERSION=${VERSION}
ENV BUILD_SHA=${BUILD_SHA}
ENV NODE_ENV=production

COPY --from=build /app/dist/apps/ml-adapter/crouton-backend ./backend
COPY --from=build /app/deployed-backend/node_modules ./node_modules
COPY --from=build /app/generated/ml-adapter/default/client ./generated/client
# Not a workspace package (see pnpm-workspace.yaml) — place it where the
# runtime-required data-sources resolve `@ml-adapter/generated-default-client`.
COPY --from=build /app/generated/ml-adapter/default/client ./node_modules/@ml-adapter/generated-default-client
COPY --from=build /app/generated/ml-adapter/default/types ./node_modules/@ml-adapter/generated-default-types

# Crouton config (runtime: CroutonApiModule.forResourceDir looks for crouton.json)
COPY apps/ml-adapter/crouton.json apps/ml-adapter/crouton.enums.json ./
# crouton.json → authProvidersDir: without this folder crouton disables auth (admin guard!)
COPY apps/ml-adapter/crouton-backend/src/app/auth-providers ./crouton-backend/src/app/auth-providers
COPY apps/ml-adapter/prisma ./prisma

EXPOSE 3000

COPY --chmod=755 <<'EOF' /usr/local/bin/annophis-start
#!/bin/sh
# `migrate` -> apply this app's Prisma migrations and exit; anything else -> start the app
if [ "$1" = migrate ]; then
  exec node /app/node_modules/prisma/build/index.js migrate deploy --config /app/prisma/default/prisma.config.ts
fi
exec node /app/backend/main.js
EOF
ENTRYPOINT ["annophis-start"]

